APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DATABASE_URL=sqlite:///./data/app.db
DOCUMENT_ROOT=data/documents
PAGE_CACHE_ROOT=data/pages
ARTIFACT_ROOT=artifacts/evaluations
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
BASELINE_COLLECTION=rag_baseline_v1
SEMANTIC_COLLECTION=rag_semantic_v1
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2
GEMINI_API_KEY=
GEMINI_GENERATION_MODEL=gemini-3.5-flash-lite
GEMINI_EVALUATOR_MODEL=gemini-3.5-flash-lite
MAX_UPLOAD_BYTES=20971520
MAX_PDF_PAGES=300
MAX_QUESTION_CHARS=2000
MAX_SELECTED_DOCUMENTS=20
GENERATION_TIMEOUT_SECONDS=60.0
GENERATION_CONCURRENCY=1
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
